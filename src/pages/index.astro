		<div class="tw-flex tw-h-full tw-w-[250px] tw-flex-col tw-gap-4">
			<h2 class="tw-text-3xl max-md:tw-text-xl">Schedule a Business Meeting</h2>
			<div class="tw-flex tw-flex-col tw-gap-3 max-md:tw-text-sm">
				<a href="mailto:Slotfi909@gmail.com" class="footer-link">Slotfi909@gmail.com</a>
				<a href="tel:+989395866475" class="footer-link">+98 939 586 6475</a>
