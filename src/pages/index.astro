---
import HeaderHero from '../components/HeaderHero.astro';
import IntroductionBenefits from '../components/IntroductionBenefits.astro';
import Showcase from '../components/Showcase.astro';
import Layout from '../layouts/Layout.astro';
---
<Layout>
	<HeaderHero />

	<IntroductionBenefits />

	<Showcase />

	<!-- Instant Data Retrieval -->
				<div
					class="reveal-up showcase-item tw-flex tw-h-[400px] tw-w-[450px] tw-flex-col tw-gap-4 tw-rounded-xl tw-border-[1px] tw-border-outlineColor tw-bg-secondary tw-p-6 tw-cursor-pointer tw-transition-all tw-duration-300 hover:tw-scale-105 hover:tw-border-primary max-md:tw-w-[320px]">
					<img class="showcase-image tw-h-[250px] tw-w-full tw-object-cover tw-rounded-lg"
						alt="Instant Data Retrieval" src="./assets/img/retrieval.png"
						data-lightbox-title="Instant Data Retrieval"
						data-lightbox-description="Find any polymer test result on your products OR your raw materials within seconds using our advanced search algorithms and intuitive interface. Quickly locate MFI results, OIT values, or yield stress data across your entire testing history." />
					<div class="showcase-content tw-flex tw-flex-col tw-gap-3">
						<h4
							class="tw-text-2xl tw-font-semibold tw-text-gray-200 max-md:tw-text-xl">
							Instant Data Retrieval</h4>
						<p class="tw-text-gray-300">Find any test result within
							seconds across your entire database</p>
					</div>
				</div>

				<!-- Advanced Analytics -->
				<div
					class="reveal-up showcase-item tw-flex tw-h-[400px] tw-w-[450px] tw-flex-col tw-gap-4 tw-rounded-xl tw-border-[1px] tw-border-outlineColor tw-bg-secondary tw-p-6 tw-cursor-pointer tw-transition-all tw-duration-300 hover:tw-scale-105 hover:tw-border-primary max-md:tw-w-[320px]">
					<img class="showcase-image tw-h-[250px] tw-w-full tw-object-cover tw-rounded-lg"
						alt="Advanced Analytics" src="./assets/img/advanced.png"
						data-lightbox-title="Advanced Analytics"
						data-lightbox-description="Generate detailed graphs and tabular reports from search results with customizable parameters and export options. Visualize polymer test trends, compare material performance, and identify quality patterns with powerful analytical tools." />
					<div class="showcase-content tw-flex tw-flex-col tw-gap-3">
						<h4
							class="tw-text-2xl tw-font-semibold tw-text-gray-200 max-md:tw-text-xl">
							Advanced Analytics</h4>
						<p class="tw-text-gray-300">Generate detailed graphs and tabular reports
							from search results with custom parameters</p>
					</div>
				</div>

				<!-- Custom Test Definition -->
				<div
					class="reveal-up showcase-item tw-flex tw-h-[400px] tw-w-[450px] tw-flex-col tw-gap-4 tw-rounded-xl tw-border-[1px] tw-border-outlineColor tw-bg-secondary tw-p-6 tw-cursor-pointer tw-transition-all tw-duration-300 hover:tw-scale-105 hover:tw-border-primary max-md:tw-w-[320px]">
					<img class="showcase-image tw-h-[250px] tw-w-full tw-object-cover tw-rounded-lg"
						alt="Custom Test Definition" src="./assets/img/test.png"
						data-lightbox-title="Custom Test Definition"
						data-lightbox-description="Easily create new testing methods like MFI, ESCR and OIT under different standard environments (e.g. ISO 1133, EN 23900, ASTM D638, etc.) " />
					<div class="showcase-content tw-flex tw-flex-col tw-gap-3">
						<h4
							class="tw-text-2xl tw-font-semibold tw-text-gray-200 max-md:tw-text-xl">
							Custom Test Definition</h4>
						<p class="tw-text-gray-300">Easily create new testing methods like MFI
							, ESCR, etc. under different standards (different ISOs, ENs
							and ASTMs)</p>
					</div>
				</div>

				<!-- Quick Data Entry -->
				<div
					class="reveal-up showcase-item tw-flex tw-h-[400px] tw-w-[450px] tw-flex-col tw-gap-4 tw-rounded-xl tw-border-[1px] tw-border-outlineColor tw-bg-secondary tw-p-6 tw-cursor-pointer tw-transition-all tw-duration-300 hover:tw-scale-105 hover:tw-border-primary max-md:tw-w-[320px]">
					<img class="showcase-image tw-h-[250px] tw-w-full tw-object-cover tw-rounded-lg"
						alt="Quick Data Entry" src="./assets/img/recording.png"
						data-lightbox-title="Quick Data Entry"
						data-lightbox-description="Fast storage system for raw materials and finished products, with resolution down to different palettes! alert the lab supervisors when product/raw material quality is lower than expected." />
					<div class="showcase-content tw-flex tw-flex-col tw-gap-3">
						<h4
							class="tw-text-2xl tw-font-semibold tw-text-gray-200 max-md:tw-text-xl">
							Quick Data Entry</h4>
						<p class="tw-text-gray-300">Fast storage system for raw materials and
							finished products.</p>
					</div>
				</div>

				<!-- Role-Based Access Control -->
				<div
					class="reveal-up showcase-item tw-flex tw-h-[400px] tw-w-[450px] tw-flex-col tw-gap-4 tw-rounded-xl tw-border-[1px] tw-border-outlineColor tw-bg-secondary tw-p-6 tw-cursor-pointer tw-transition-all tw-duration-300 hover:tw-scale-105 hover:tw-border-primary max-md:tw-w-[320px]">
					<img class="showcase-image tw-h-[250px] tw-w-full tw-object-cover tw-rounded-lg"
						alt="Role-Based Access Control" src="./assets/img/settings.png"
						data-lightbox-title="Role-Based Access Control"
						data-lightbox-description="Three user permission levels ensure proper data security management with granular access controls. Protect sensitive polymer formulations and test results while enabling appropriate access for technicians, supervisors, and administrators." />
					<div class="showcase-content tw-flex tw-flex-col tw-gap-3">
						<h4
							class="tw-text-2xl tw-font-semibold tw-text-gray-200 max-md:tw-text-xl">
							Role-Based Access Control</h4>
						<p class="tw-text-gray-300">Three user permission levels ensure proper
							data security management</p>
					</div>
				</div>

				<!-- Export Flexibility -->
				<div
					class="reveal-up showcase-item tw-flex tw-h-[400px] tw-w-[450px] tw-flex-col tw-gap-4 tw-rounded-xl tw-border-[1px] tw-border-outlineColor tw-bg-secondary tw-p-6 tw-cursor-pointer tw-transition-all tw-duration-300 hover:tw-scale-105 hover:tw-border-primary max-md:tw-w-[320px]">
					<img class="showcase-image tw-h-[250px] tw-w-full tw-object-cover tw-rounded-lg"
						alt="Export Flexibility" src="./assets/img/report.png"
						data-lightbox-title="Export Flexibility"
						data-lightbox-description="Export reports as images, spreadsheets, or PDFs instantly with customizable formatting options. Share polymer test results, quality certificates, and analytical reports with stakeholders in their preferred format with just a few clicks." />
					<div class="showcase-content tw-flex tw-flex-col tw-gap-3">
						<h4
							class="tw-text-2xl tw-font-semibold tw-text-gray-200 max-md:tw-text-xl">
							Export Flexibility</h4>
						<p class="tw-text-gray-300">Export reports as images, spreadsheets, or
							PDFs instantly with custom formatting</p>
					</div>
				</div>

			</div>
		</div>
	</section>

