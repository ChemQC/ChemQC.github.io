---
import { en } from '../i18n'
---
<section id="action" data-lightbox-close={en['controls.close']} data-i18n-data-lightbox-close="controls.close"
		class="tw-relative tw-flex tw-min-h-[80vh] tw-w-full tw-max-w-[100vw] tw-flex-col tw-place-content-center tw-place-items-center tw-overflow-hidden tw-p-6">
		<div class="tw-mt-8 tw-flex tw-flex-col tw-place-items-center tw-gap-5">
			<div class="reveal-up tw-mt-5 tw-flex tw-flex-col tw-gap-3 tw-text-center">
				<h2 class="tw-text-4xl tw-font-medium tw-text-gray-200 max-md:tw-text-2xl" data-i18n="showcase.title">
					{en['showcase.title']}
				</h2>
				<p class="tw-text-xl tw-text-gray-300 max-md:tw-text-lg" data-i18n="showcase.subtitle">
					{en['showcase.subtitle']}
				</p>
			</div>
			<div
				class="tw-mt-6 tw-flex tw-max-w-[80%] tw-flex-wrap tw-place-content-center tw-gap-8 max-lg:tw-flex-col">

	<!-- Instant Data Retrieval -->
				<div
					class="reveal-up showcase-item tw-flex tw-h-[400px] tw-w-[450px] tw-flex-col tw-gap-4 tw-rounded-xl tw-border-[1px] tw-border-outlineColor tw-bg-secondary tw-p-6 tw-cursor-pointer tw-transition-all tw-duration-300 hover:tw-scale-105 hover:tw-border-primary max-md:tw-w-[320px]">
					<img class="showcase-image tw-h-[250px] tw-w-full tw-object-cover tw-rounded-lg"
						alt={en['showcase.retrieval.title']} data-i18n-alt="showcase.retrieval.title" src="./assets/img/retrieval.png"
						data-i18n-data-lightbox-title="showcase.retrieval.title" data-i18n-data-lightbox-description="showcase.retrieval.description"
						data-lightbox-title={en['showcase.retrieval.title']} data-lightbox-description={en['showcase.retrieval.description']} />
					<div class="showcase-content tw-flex tw-flex-col tw-gap-3">
						<h4
							class="tw-text-2xl tw-font-semibold tw-text-gray-200 max-md:tw-text-xl" data-i18n="showcase.retrieval.title">
							{en['showcase.retrieval.title']}</h4>
						<p class="tw-text-gray-300" data-i18n="showcase.retrieval.summary">{en['showcase.retrieval.summary']}</p>
					</div>
				</div>

				<!-- Advanced Analytics -->
				<div
					class="reveal-up showcase-item tw-flex tw-h-[400px] tw-w-[450px] tw-flex-col tw-gap-4 tw-rounded-xl tw-border-[1px] tw-border-outlineColor tw-bg-secondary tw-p-6 tw-cursor-pointer tw-transition-all tw-duration-300 hover:tw-scale-105 hover:tw-border-primary max-md:tw-w-[320px]">
					<img class="showcase-image tw-h-[250px] tw-w-full tw-object-cover tw-rounded-lg"
						alt={en['showcase.analytics.title']} data-i18n-alt="showcase.analytics.title" src="./assets/img/advanced.png"
						data-i18n-data-lightbox-title="showcase.analytics.title" data-i18n-data-lightbox-description="showcase.analytics.description"
						data-lightbox-title={en['showcase.analytics.title']} data-lightbox-description={en['showcase.analytics.description']} />
					<div class="showcase-content tw-flex tw-flex-col tw-gap-3">
						<h4
							class="tw-text-2xl tw-font-semibold tw-text-gray-200 max-md:tw-text-xl" data-i18n="showcase.analytics.title">
							{en['showcase.analytics.title']}</h4>
						<p class="tw-text-gray-300" data-i18n="showcase.analytics.summary">{en['showcase.analytics.summary']}</p>
					</div>
				</div>

				<!-- Custom Test Definition -->
				<div
					class="reveal-up showcase-item tw-flex tw-h-[400px] tw-w-[450px] tw-flex-col tw-gap-4 tw-rounded-xl tw-border-[1px] tw-border-outlineColor tw-bg-secondary tw-p-6 tw-cursor-pointer tw-transition-all tw-duration-300 hover:tw-scale-105 hover:tw-border-primary max-md:tw-w-[320px]">
					<img class="showcase-image tw-h-[250px] tw-w-full tw-object-cover tw-rounded-lg"
						alt={en['showcase.test.title']} data-i18n-alt="showcase.test.title" src="./assets/img/test.png"
						data-i18n-data-lightbox-title="showcase.test.title" data-i18n-data-lightbox-description="showcase.test.description"
						data-lightbox-title={en['showcase.test.title']} data-lightbox-description={en['showcase.test.description']} />
					<div class="showcase-content tw-flex tw-flex-col tw-gap-3">
						<h4
							class="tw-text-2xl tw-font-semibold tw-text-gray-200 max-md:tw-text-xl" data-i18n="showcase.test.title">
							{en['showcase.test.title']}</h4>
						<p class="tw-text-gray-300" data-i18n="showcase.test.summary">{en['showcase.test.summary']}</p>
					</div>
				</div>

				<!-- Quick Data Entry -->
				<div
					class="reveal-up showcase-item tw-flex tw-h-[400px] tw-w-[450px] tw-flex-col tw-gap-4 tw-rounded-xl tw-border-[1px] tw-border-outlineColor tw-bg-secondary tw-p-6 tw-cursor-pointer tw-transition-all tw-duration-300 hover:tw-scale-105 hover:tw-border-primary max-md:tw-w-[320px]">
					<img class="showcase-image tw-h-[250px] tw-w-full tw-object-cover tw-rounded-lg"
						alt={en['showcase.entry.title']} data-i18n-alt="showcase.entry.title" src="./assets/img/recording.png"
						data-i18n-data-lightbox-title="showcase.entry.title" data-i18n-data-lightbox-description="showcase.entry.description"
						data-lightbox-title={en['showcase.entry.title']} data-lightbox-description={en['showcase.entry.description']} />
					<div class="showcase-content tw-flex tw-flex-col tw-gap-3">
						<h4
							class="tw-text-2xl tw-font-semibold tw-text-gray-200 max-md:tw-text-xl" data-i18n="showcase.entry.title">
							{en['showcase.entry.title']}</h4>
						<p class="tw-text-gray-300" data-i18n="showcase.entry.summary">{en['showcase.entry.summary']}</p>
					</div>
				</div>

				<!-- Role-Based Access Control -->
				<div
					class="reveal-up showcase-item tw-flex tw-h-[400px] tw-w-[450px] tw-flex-col tw-gap-4 tw-rounded-xl tw-border-[1px] tw-border-outlineColor tw-bg-secondary tw-p-6 tw-cursor-pointer tw-transition-all tw-duration-300 hover:tw-scale-105 hover:tw-border-primary max-md:tw-w-[320px]">
					<img class="showcase-image tw-h-[250px] tw-w-full tw-object-cover tw-rounded-lg"
						alt={en['showcase.access.title']} data-i18n-alt="showcase.access.title" src="./assets/img/settings.png"
						data-i18n-data-lightbox-title="showcase.access.title" data-i18n-data-lightbox-description="showcase.access.description"
						data-lightbox-title={en['showcase.access.title']} data-lightbox-description={en['showcase.access.description']} />
					<div class="showcase-content tw-flex tw-flex-col tw-gap-3">
						<h4
							class="tw-text-2xl tw-font-semibold tw-text-gray-200 max-md:tw-text-xl" data-i18n="showcase.access.title">
							{en['showcase.access.title']}</h4>
						<p class="tw-text-gray-300" data-i18n="showcase.access.summary">{en['showcase.access.summary']}</p>
					</div>
				</div>

				<!-- Export Flexibility -->
				<div
					class="reveal-up showcase-item tw-flex tw-h-[400px] tw-w-[450px] tw-flex-col tw-gap-4 tw-rounded-xl tw-border-[1px] tw-border-outlineColor tw-bg-secondary tw-p-6 tw-cursor-pointer tw-transition-all tw-duration-300 hover:tw-scale-105 hover:tw-border-primary max-md:tw-w-[320px]">
					<img class="showcase-image tw-h-[250px] tw-w-full tw-object-cover tw-rounded-lg"
						alt={en['showcase.export.title']} data-i18n-alt="showcase.export.title" src="./assets/img/report.png"
						data-i18n-data-lightbox-title="showcase.export.title" data-i18n-data-lightbox-description="showcase.export.description"
						data-lightbox-title={en['showcase.export.title']} data-lightbox-description={en['showcase.export.description']} />
					<div class="showcase-content tw-flex tw-flex-col tw-gap-3">
						<h4
							class="tw-text-2xl tw-font-semibold tw-text-gray-200 max-md:tw-text-xl" data-i18n="showcase.export.title">
							{en['showcase.export.title']}</h4>
						<p class="tw-text-gray-300" data-i18n="showcase.export.summary">{en['showcase.export.summary']}</p>
					</div>
				</div>

			</div>
		</div>
	</section>
