---
import { en } from '../i18n'
---
<section id="faq"
		class="tw-flex tw-w-full tw-flex-col tw-place-content-center tw-place-items-center tw-gap-[10%] tw-p-[5%] tw-px-[10%]">
		<h3 class="tw-text-4xl tw-font-medium tw-text-gray-300 max-md:tw-text-2xl" data-i18n="faq.title">{en['faq.title']}
		</h3>
		<div class="tw-mt-5 tw-flex tw-min-h-[300px] tw-w-full tw-max-w-[850px] tw-flex-col tw-gap-4">
			<div
				class="faq tw-w-full tw-rounded-md tw-border-[1px] tw-border-solid tw-border-[#1F2123] tw-bg-[#080808]">
				<div
					class="faq-accordion tw-flex tw-w-full tw-select-none tw-text-xl max-md:tw-text-lg">
					<span data-i18n="faq.tests.question">{en['faq.tests.question']}</span>
					<i class="bi bi-plus tw-ml-auto tw-font-semibold"></i>
				</div>
				<div class="content" data-i18n="faq.tests.answer">{en['faq.tests.answer']}
				</div>
			</div>

			<div
				class="faq tw-w-full tw-rounded-md tw-border-[1px] tw-border-solid tw-border-[#1F2123] tw-bg-[#080808]">
				<div
					class="faq-accordion tw-flex tw-w-full tw-select-none tw-text-xl max-md:tw-text-lg">
					<span data-i18n="faq.installation.question">{en['faq.installation.question']}</span>
					<i class="bi bi-plus tw-ml-auto tw-font-semibold"></i>
				</div>
				<div class="content" data-i18n="faq.installation.answer">{en['faq.installation.answer']}</div>
			</div>

			<div
				class="faq tw-w-full tw-rounded-md tw-border-[1px] tw-border-solid tw-border-[#1F2123] tw-bg-[#080808]">
				<div
					class="faq-accordion tw-flex tw-w-full tw-select-none tw-text-xl max-md:tw-text-lg">
					<span data-i18n="faq.standards.question">{en['faq.standards.question']}</span>
					<i class="bi bi-plus tw-ml-auto tw-font-semibold"></i>
				</div>
				<div class="content" data-i18n="faq.standards.answer">{en['faq.standards.answer']}</div>
			</div>

			<div
				class="faq tw-w-full tw-rounded-md tw-border-[1px] tw-border-solid tw-border-[#1F2123] tw-bg-[#080808]">
				<div
					class="faq-accordion tw-flex tw-w-full tw-select-none tw-text-xl max-md:tw-text-lg">
					<span data-i18n="faq.workflow.question">{en['faq.workflow.question']}</span>
					<i class="bi bi-plus tw-ml-auto tw-font-semibold"></i>
				</div>
				<div class="content" data-i18n="faq.workflow.answer">{en['faq.workflow.answer']}
				</div>
			</div>
		</div>

		<div class="tw-mt-20 tw-flex tw-flex-col tw-place-items-center tw-gap-4">
			<div class="tw-text-3xl max-md:tw-text-2xl" data-i18n="faq.more">
				{en['faq.more']}
			</div>
			<a href={`mailto:Slotfi909@gmail.com?subject=${encodeURIComponent(en['faq.contactSubject'])}`} data-i18n-subject="faq.contactSubject" data-i18n="faq.contact"
				class="btn !tw-rounded-full !tw-border-[1px] !tw-border-solid !tw-border-gray-300 !tw-bg-transparent tw-transition-colors tw-duration-[0.3s]">
				{en['faq.contact']}
			</a>
		</div>
	</section>



	<footer id="about"
		class="tw-mt-auto tw-flex tw-w-full tw-place-content-around tw-gap-3 tw-p-[5%] tw-px-[10%] tw-text-white max-md:tw-flex-col">
		<div class="tw-flex tw-h-full tw-w-[250px] tw-flex-col tw-place-items-center tw-gap-6 max-md:tw-w-full">
			<img src="./assets/logo/logo.png" alt={en['images.logo']} data-i18n-alt="images.logo" class="site-logo tw-max-w-[120px]" />
			<div>
				<span data-i18n="footer.university">{en['footer.university']}</span>
				<br />
				<span data-i18n="footer.city">{en['footer.city']}</span>
				<br />
				<span data-i18n="footer.country">{en['footer.country']}</span>
			</div>
