					<i class="bi bi-instagram"></i>
				</a>
			</div>
-->
		</div>
		<div class="tw-flex tw-h-full tw-w-[250px] tw-flex-col tw-gap-4">
			<h2 class="tw-text-3xl max-md:tw-text-xl" data-i18n="footer.meeting">{en['footer.meeting']}</h2>
			<div class="tw-flex tw-flex-col tw-gap-3 max-md:tw-text-sm">
				<a href="mailto:Slotfi909@gmail.com" class="footer-link" dir="ltr">Slotfi909@gmail.com</a>
				<a href="tel:+989395866475" class="footer-link" dir="ltr">+98 939 586 6475</a>
				<a href="https://t.me/lsorooshl" class="footer-link"><span data-i18n="footer.telegram">{en['footer.telegram']}</span> <bdi dir="ltr">@lsorooshl</bdi></a>


			</div>
		</div>

		<div class="tw-flex tw-h-full tw-w-[250px] tw-flex-col tw-gap-4">
			<h2 class="tw-text-3xl max-md:tw-text-xl" data-i18n="footer.about">{en['footer.about']}</h2>
			<div class="tw-flex tw-flex-col tw-gap-3 max-md:tw-text-sm">
				<p class="tw-text-gray-300 tw-text-sm tw-leading-relaxed" data-i18n="footer.description">
					{en['footer.description']}
				</p>
			</div>
		</div>



	</footer>
