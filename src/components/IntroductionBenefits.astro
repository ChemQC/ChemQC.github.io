---
import { en } from '../i18n'
---
<section id="intro"
		class="tw-relative tw-flex tw-min-h-[80vh] tw-w-full tw-max-w-[100vw] tw-flex-col tw-place-content-center tw-place-items-center tw-overflow-hidden tw-p-6">
		<div class="tw-mt-8 tw-flex tw-flex-col tw-place-items-center tw-gap-5">
			<div class="reveal-up tw-mt-5 tw-flex tw-flex-col tw-gap-3 tw-text-center">
				<h2 class="tw-text-4xl tw-font-medium tw-text-gray-200 max-md:tw-text-2xl" data-i18n="intro.title">
					{en['intro.title']}
				</h2>
				<p class="tw-text-xl tw-text-gray-300 max-md:tw-text-lg" data-i18n="intro.subtitle">
					{en['intro.subtitle']}
				</p>
			</div>

			<!-- VERTICAL STACK WITH CARD VISUALS -->
			<div
				class="tw-mt-6 tw-flex tw-max-w-[80%] tw-flex-col tw-place-content-center tw-gap-12 max-lg:tw-max-w-full">

				<!-- PROBLEM - Top -->
				<div
					class="reveal-up tw-flex tw-w-full tw-gap-8 tw-place-items-center max-lg:tw-flex-col">
					<div class="tw-flex-shrink-0 tw-text-center max-lg:tw-mb-4">
						<div
							class="border-gradient tw-h-[200px] tw-w-[200px] tw-overflow-hidden tw-rounded-lg max-md:tw-h-[150px] max-md:tw-w-[150px]">
							<div
								class="tw-flex tw-h-full tw-w-full tw-place-content-center tw-place-items-center tw-p-2">
								<i
									class="bi bi-clipboard-x-fill tw-text-7xl tw-text-gray-200 max-md:tw-text-5xl"></i>
							</div>
						</div>
					</div>
					<div class="tw-flex tw-flex-col tw-gap-4">
						<h3
							class="tw-text-3xl tw-font-normal tw-text-gray-200 max-md:tw-text-2xl" data-i18n="intro.problem.title">
							{en['intro.problem.title']}</h3>
						<div class="tw-text-lg tw-text-gray-300 max-md:tw-text-base" data-i18n="intro.problem.description">
							{en['intro.problem.description']}
						</div>
					</div>
				</div>

				<!-- SOLUTION - Middle -->
				<div
					class="reveal-up tw-flex tw-w-full tw-gap-8 tw-place-items-center max-lg:tw-flex-col">
					<div class="tw-flex-shrink-0 tw-text-center max-lg:tw-mb-4">
						<div
							class="border-gradient tw-h-[200px] tw-w-[200px] tw-overflow-hidden tw-rounded-lg max-md:tw-h-[150px] max-md:tw-w-[150px]">
							<div
								class="tw-flex tw-h-full tw-w-full tw-place-content-center tw-place-items-center tw-p-2">
								<i
									class="bi bi-database-check tw-text-7xl tw-text-gray-200 max-md:tw-text-5xl"></i>
							</div>
						</div>
					</div>
					<div class="tw-flex tw-flex-col tw-gap-4">
						<h3
							class="tw-text-3xl tw-font-normal tw-text-gray-200 max-md:tw-text-2xl" data-i18n="intro.solution.title">
							{en['intro.solution.title']}</h3>
						<div class="tw-text-lg tw-text-gray-300 max-md:tw-text-base" data-i18n="intro.solution.description">
							{en['intro.solution.description']}
						</div>
					</div>
				</div>

				<!-- IMPACT - Bottom -->
				<div
					class="reveal-up tw-flex tw-w-full tw-gap-8 tw-place-items-center max-lg:tw-flex-col">
					<div class="tw-flex-shrink-0 tw-text-center max-lg:tw-mb-4">
						<div
							class="border-gradient tw-h-[200px] tw-w-[200px] tw-overflow-hidden tw-rounded-lg max-md:tw-h-[150px] max-md:tw-w-[150px]">
							<div
								class="tw-flex tw-h-full tw-w-full tw-place-content-center tw-place-items-center tw-p-2">
								<i
									class="bi bi-graph-up-arrow tw-text-7xl tw-text-gray-200 max-md:tw-text-5xl"></i>
							</div>
						</div>
					</div>
					<div class="tw-flex tw-flex-col tw-gap-4">
						<h3
							class="tw-text-3xl tw-font-normal tw-text-gray-200 max-md:tw-text-2xl" data-i18n="intro.impact.title">
							{en['intro.impact.title']}</h3>
						<div class="tw-text-lg tw-text-gray-300 max-md:tw-text-base" data-i18n="intro.impact.description">
							{en['intro.impact.description']}
						</div>
					</div>
				</div>

			</div>
		</div>
	</section>

	<section
		class="tw-relative tw-flex tw-w-full tw-max-w-[100vw] tw-flex-col tw-place-content-center tw-place-items-center tw-overflow-hidden tw-p-6">
		<div class="tw-mt-8 tw-flex tw-flex-col tw-place-items-center tw-gap-5">
			<div class="reveal-up tw-mt-5 tw-flex tw-flex-col tw-gap-3 tw-text-center">
				<h2 class="tw-text-4xl tw-font-medium tw-text-gray-200 max-md:tw-text-3xl" data-i18n="benefits.title">
					{en['benefits.title']}
				</h2>
			</div>
			<div
				class="tw-mt-6 tw-flex tw-max-w-[80%] tw-flex-wrap tw-place-content-center tw-gap-8 max-lg:tw-flex-col">

				<!-- Database Management -->
				<div
					class="reveal-up benefit-card tw-flex tw-h-[400px] tw-w-[450px] tw-flex-col tw-gap-3 tw-text-center max-md:tw-w-[320px]">
					<div
						class="border-gradient tw-h-[200px] tw-w-full tw-overflow-hidden max-md:tw-h-[150px]">
					<div class="benefit-icon">
							<i
								class="bi bi-database-fill tw-text-7xl tw-text-gray-200 max-md:tw-text-5xl"></i>
						</div>
					</div>
					<div class="tw-flex tw-flex-col tw-gap-4 tw-p-2">
						<h3 class="tw-mt-8 tw-text-2xl tw-font-normal max-md:tw-text-xl" data-i18n="benefits.database.title">
							{en['benefits.database.title']}
						</h3>
						<div class="tw-text-gray-300" data-i18n="benefits.database.description">{en['benefits.database.description']}</div>
					</div>
				</div>

				<!-- Custom Feature Development -->
				<div
					class="reveal-up benefit-card tw-flex tw-h-[400px] tw-w-[450px] tw-flex-col tw-gap-3 tw-text-center max-md:tw-w-[320px]">
					<div
						class="border-gradient tw-h-[200px] tw-w-full tw-overflow-hidden max-md:tw-text-[150px]">
						<div
							class="benefit-icon">
							<i
								class="bi bi-tools tw-text-7xl tw-text-gray-200 max-md:tw-text-5xl"></i>
						</div>
					</div>
					<div class="tw-flex tw-flex-col tw-gap-4 tw-p-2">
						<h3 class="tw-mt-8 tw-text-2xl tw-font-normal max-md:tw-text-xl" data-i18n="benefits.custom.title">
							{en['benefits.custom.title']}
						</h3>
						<div class="tw-text-gray-300" data-i18n="benefits.custom.description">{en['benefits.custom.description']}</div>
					</div>
				</div>

				<!-- Automated Backup -->
				<div
					class="reveal-up benefit-card tw-flex tw-h-[400px] tw-w-[450px] tw-flex-col tw-gap-3 tw-text-center max-md:tw-w-[320px]">
					<div
						class="border-gradient tw-h-[200px] tw-w-full tw-overflow-hidden max-md:tw-h-[150px]">
						<div
							class="benefit-icon">
							<i
								class="bi bi-shield-check tw-text-7xl tw-text-gray-200 max-md:tw-text-5xl"></i>
						</div>
					</div>
					<div class="tw-flex tw-flex-col tw-gap-4 tw-p-2">
						<h3 class="tw-mt-8 tw-text-2xl tw-font-normal max-md:tw-text-xl" data-i18n="benefits.backup.title">
							{en['benefits.backup.title']}
						</h3>
						<div class="tw-text-gray-300" data-i18n="benefits.backup.description">{en['benefits.backup.description']}</div>
					</div>
				</div>

			</div>
		</div>
	</section>
